# Copy to .env.local. Use a NEW hosted project or the local Supabase CLI.
# Never copy the deleted project's credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Razorpay sandbox only. Never prefix secrets with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Supabase dashboard > Settings > API keys > Secret keys (server only).
SUPABASE_SECRET_KEY=

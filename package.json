{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test --test-concurrency=1 tests/database.test.ts tests/community.test.ts tests/ratings.test.ts tests/profiles.test.ts tests/payments.test.ts tests/payment-gateway.test.ts tests/validation.test.ts tests/session-presentation.test.ts tests/theme.test.ts tests/search.test.ts tests/hosted-workers.test.ts tests/notifications.test.ts tests/notification-delivery.test.ts && npm run test:payment-flow",
    "test:payment-flow": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/payment-flow.test.ts",
    "payments:work": "node --env-file=.env.local --conditions=react-server --import tsx scripts/payments-worker.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "notifications:work": "node --conditions=react-server --import tsx scripts/notifications-worker.ts",
    "notifications:status": "npm run notifications:work -- --status",
    "notifications:demo": "node --import tsx scripts/notifications-demo.ts",
    "notifications:watch": "node --conditions=react-server --import tsx scripts/notifications-worker.ts --watch"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.1",
    "lucide-react": "1.75.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postgres": "4.1.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
